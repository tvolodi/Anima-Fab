{
  "name": "s02-ep03-enterprise-modelling-and-process-orientation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice": "node -e \"const fs=require('fs');fs.mkdirSync('public/voice',{recursive:true});for(const f of fs.readdirSync('voice/out'))fs.copyFileSync('voice/out/'+f,'public/voice/'+f);console.log('synced '+fs.readdirSync('public/voice').length+' clips')\"",
    "voice:en": "node -e \"const fs=require('fs');fs.mkdirSync('public/voice.en',{recursive:true});for(const f of fs.readdirSync('voice/out.en'))fs.copyFileSync('voice/out.en/'+f,'public/voice.en/'+f);console.log('synced '+fs.readdirSync('public/voice.en').length+' clips')\"",
    "sound": "node -e \"const fs=require('fs');fs.mkdirSync('public/music',{recursive:true});for(const f of ['warm-pad-drone','mystic-minimal-loop','atmospheric-piano']){fs.copyFileSync('../../assets/sound-library/music/'+f+'.mp3','public/music/'+f+'.mp3');console.log('synced '+f+'.mp3')}\"",
    "render": "remotion render src/index.ts Episode out/s02-ep03.mp4",
    "render:en": "remotion render src/index.ts Episode out/s02-ep03-en.mp4 --props='{\"lang\":\"en\"}'",
    "still": "remotion still src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anima/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.250",
    "@remotion/cli": "^4.0.250"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
